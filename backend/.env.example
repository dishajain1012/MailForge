# Server & Environment
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<dbname>?schema=public

# Redis Configuration (BullMQ & Rate Limiting)
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# Ethereal SMTP Configuration
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Slack OAuth Configuration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://<your-backend-domain>/api/slack/callback

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://<your-backend-domain>/api/auth/google/callback

# Session Secret (Generate a strong random string)
SESSION_SECRET=your_production_session_secret

# CORS Configuration (Frontend URL)
CLIENT_URL=https://<your-frontend-domain>
